<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:DownKyi.Core.Settings;assembly=DownKyi.Core"
             xmlns:vms="clr-namespace:DownKyi.ViewModels.Settings"
             x:Class="DownKyi.Views.Settings.NetworkGeneralSettingsView"
             x:DataType="vms:ViewNetworkViewModel">
    <StackPanel Orientation="Vertical">
        <TextBlock
            Name="NameNetworkPageTitle"
            Margin="0,20,0,0"
            FontSize="{DynamicResource DownKyiFontSizeTitle}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource BrushTextPrimary}"
            Text="{DynamicResource Network}" />

        <StackPanel
            Name="NameNetworkConnectionSection"
            Margin="0,28,0,0">
            <TextBlock
                Name="NameNetworkConnectionTitle"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource BrushTextPrimary}"
                Text="{DynamicResource NetworkConnectionSection}" />

            <StackPanel
                Name="NameNetworkProxySection"
                Margin="0,12,0,0"
                HorizontalAlignment="Left">
                <TextBlock
                    Name="NameNetworkProxyTitle"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource BrushTextPrimary}"
                    Text="{StaticResource NetworkProxySetting}" />
                <StackPanel
                    Name="NameNetworkProxyChoices"
                    Margin="0,8,0,0"
                    Spacing="4">
                    <RadioButton
                        Name="NameNetworkProxyNone"
                        IsChecked="{Binding NetworkProxy,Converter={x:Static ObjectConverters.Equal},ConverterParameter={x:Static settings:NetworkProxy.None}}"
                        Command="{Binding NetworkProxyCommand}"
                        CommandParameter="{x:Static settings:NetworkProxy.None}"
                        Content="{StaticResource NetworkProxyNone}"
                        GroupName="proxy" />
                    <RadioButton
                        Name="NameNetworkProxySystem"
                        IsChecked="{Binding NetworkProxy,Converter={x:Static ObjectConverters.Equal},ConverterParameter={x:Static settings:NetworkProxy.System}}"
                        Command="{Binding NetworkProxyCommand}"
                        CommandParameter="{x:Static settings:NetworkProxy.System}"
                        Content="{StaticResource NetworkProxySystem}"
                        GroupName="proxy" />
                    <RadioButton
                        Name="NameNetworkProxyCustom"
                        IsChecked="{Binding NetworkProxy,Converter={x:Static ObjectConverters.Equal},ConverterParameter={x:Static settings:NetworkProxy.Custom}}"
                        Command="{Binding NetworkProxyCommand}"
                        CommandParameter="{x:Static settings:NetworkProxy.Custom}"
                        Content="{StaticResource NetworkProxyCustom}"
                        GroupName="proxy" />
                    <StackPanel
                        IsVisible="{Binding NetworkProxy,Converter={x:Static ObjectConverters.Equal},ConverterParameter={x:Static settings:NetworkProxy.Custom}}"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        ToolTip.Tip="{DynamicResource PressEnterToApplySettingTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource DownKyiFontSizeBody}"
                                Foreground="{DynamicResource BrushTextDark}"
                                Text="{DynamicResource HttpProxy}" />
                            <TextBox
                                Name="CustomNetworkProxy"
                                Width="220"
                                VerticalContentAlignment="Center"
                                Text="{Binding CustomNetworkProxy}">
                                <TextBox.KeyBindings>
                                    <KeyBinding
                                        Command="{Binding CustomNetworkProxyCommand}"
                                        CommandParameter="{Binding #CustomNetworkProxy.Text}"
                                        Gesture="Enter" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,18,0,0">
                <TextBlock
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource BrushTextDark}"
                    Text="{DynamicResource UserAgent}" />

                <TextBox
                    Name="NameUserAgent"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Text="{Binding UserAgent}">
                    <TextBox.KeyBindings>
                        <KeyBinding
                            Command="{Binding UserAgentCommand}"
                            CommandParameter="{Binding #NameUserAgent.Text}"
                            Gesture="Enter" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
        </StackPanel>

        <StackPanel
            Name="NameDownloaderSection"
            Margin="0,32,0,0">
            <TextBlock
                Name="NameDownloaderTitle"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource BrushTextPrimary}"
                Text="{DynamicResource DownloaderSection}" />

            <TextBlock
                Margin="0,12,0,0"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                Foreground="{DynamicResource BrushTextDark}"
                Text="{DynamicResource SelectDownloader}" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <RadioButton
                    Command="{Binding SelectDownloaderCommand}"
                    CommandParameter="Builtin"
                    Content="{DynamicResource BuiltinDownloader}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource BrushTextDark}"
                    IsChecked="{Binding Builtin}" />
                <RadioButton
                    Margin="20,0,0,0"
                    Command="{Binding SelectDownloaderCommand}"
                    CommandParameter="Aria2c"
                    Content="{DynamicResource Aria2cDownloader}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource BrushTextDark}"
                    IsChecked="{Binding Aria2C}" />
                <RadioButton
                    Margin="20,0,0,0"
                    Command="{Binding SelectDownloaderCommand}"
                    CommandParameter="CustomAria2c"
                    Content="{DynamicResource CustomAria2cDownloader}"
                    FontSize="{DynamicResource DownKyiFontSizeBody}"
                    Foreground="{DynamicResource BrushTextDark}"
                    IsChecked="{Binding CustomAria2C}" />
            </StackPanel>

            <CheckBox
                Name="NameHighSpeedDownloadMode"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding HighSpeedDownloadModeCommand}"
                Content="{DynamicResource HighSpeedDownloadMode}"
                FontSize="{DynamicResource DownKyiFontSizeBody}"
                Foreground="{DynamicResource BrushTextDark}"
                IsChecked="{Binding HighSpeedDownloadMode, Mode=TwoWay}"
                ToolTip.Tip="{DynamicResource HighSpeedDownloadModeTip}" />
        </StackPanel>
    </StackPanel>
</UserControl>
