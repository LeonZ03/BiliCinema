<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="clr-namespace:DownKyi.CustomControl"
             xmlns:vm="clr-namespace:DownKyi.ViewModels"
             x:Class="DownKyi.Views.VideoDetailToolbarView"
             x:DataType="vm:ViewVideoDetailViewModel"
             mc:Ignorable="d">
    <Grid ColumnDefinitions="40,*,50">
        <Button
            Grid.Column="0"
            Width="24"
            Height="24"
            Margin="10,5"
            VerticalAlignment="Center"
            Command="{Binding BackSpaceCommand}"
            Theme="{StaticResource ImageBtnStyle}">
            <ContentControl>
                <Path
                    Theme="{StaticResource NavigationIcon.ArrowBack}"
                    Width="24"
                    Height="24"
                    Fill="{DynamicResource ColorTextDark}"
                    Stretch="None" />
            </ContentControl>
        </Button>
        <Border Grid.Column="1"
                Height="32"
                Margin="0,5,0,5"
                BorderThickness="0"
                CornerRadius="16">
            <TextBox
                Padding="16,0,30,0"
                VerticalContentAlignment="Center"
                BorderThickness="1"
                CornerRadius="16"
                FontSize="12"
                Text="{Binding UiState.InputText,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                     Color="{DynamicResource ColorControlStrokeFocus}" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                </TextBox.Resources>
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding InputCommand}" Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>
        </Border>

        <custom:Loading Grid.Column="1"
                        Width="24"
                        Height="24"
                        Margin="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        IsActive="True"
                        IsVisible="{Binding UiState.IsBusy}" />

        <Button
            Grid.Column="2"
            Width="36"
            Height="36"
            Margin="7,0"
            VerticalAlignment="Center"
            Command="{Binding DownloadManagerCommand}"
            Theme="{StaticResource ImageBtnStyle}">
            <Grid Width="34" Height="34" ClipToBounds="False">
                <Path
                    Width="{Binding UiState.DownloadManage.Width}"
                    Height="{Binding UiState.DownloadManage.Height}"
                    Data="{Binding UiState.DownloadManage.Data}"
                    Fill="{DynamicResource BrushPrimary}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        MinWidth="14"
                        Height="14"
                        Padding="2,0"
                        Background="{DynamicResource BrushPrimary}"
                        BorderBrush="{DynamicResource BrushSurfaceRaised}"
                        BorderThickness="1"
                        CornerRadius="7"
                        IsVisible="{Binding HasActiveDownloads}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding ActiveDownloadingCount}" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</UserControl>
