<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DownKyi.ViewModels.Toolbox"
             xmlns:customControl="clr-namespace:DownKyi.CustomControl"
             x:Class="DownKyi.Views.Toolbox.ViewDelogo"
             x:DataType="vm:ViewDelogoViewModel"
             Background="{DynamicResource BrushSurfaceBase}"
             Foreground="{DynamicResource BrushTextPrimary}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,28,48,32">
            <TextBlock
                Name="NameDelogoTitle"
                FontSize="{DynamicResource DownKyiFontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource BrushTextPrimary}"
                Text="{DynamicResource Delogo}" />

            <StackPanel Margin="0,24,0,0">
                <TextBlock
                    Foreground="{DynamicResource BrushTextPrimary}"
                    Text="{DynamicResource VideoFilePath}" />
                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                    <TextBox
                        Name="NameVideoPath"
                        Grid.Column="0"
                        Height="36"
                        Padding="12,8"
                        VerticalContentAlignment="Center"
                        IsReadOnly="True"
                        Text="{Binding VideoPath, Mode=TwoWay}" />
                    <Button
                        Name="NameSelectVideoButton"
                        Grid.Column="1"
                        Height="36"
                        MinWidth="112"
                        Margin="12,0,0,0"
                        Command="{Binding SelectVideoCommand}"
                        Content="{DynamicResource SelectVideo}"
                        Theme="{StaticResource BtnStyle}" />
                </Grid>
            </StackPanel>

            <Grid Margin="0,24,0,0" ColumnDefinitions="*,312">
                <Border
                    Name="NameVideoPreview"
                    Grid.Column="0"
                    Height="328"
                    Background="{DynamicResource BrushMediaCanvas}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1">
                    <customControl:VideoFramePreview
                        EdgeThreshold="5"
                        IsWatermarkInteractive="True"
                        Source="{Binding Source}"
                        WatermarkBrush="{Binding SelectedColor}"
                        WatermarkRect="{Binding WatermarkArea, Mode=TwoWay}"
                        WatermarkThickness="2" />
                </Border>

                <Border
                    Name="NameLogoGeometryPanel"
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    Padding="16"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock
                                Name="NameLogoGeometryTitle"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource BrushTextPrimary}"
                                Text="{DynamicResource LogoSizeAndLocation}" />
                            <TextBlock
                                Name="NameLogoGeometryTip"
                                Margin="0,4,0,0"
                                FontSize="{DynamicResource DownKyiFontSizeCaption}"
                                Foreground="{DynamicResource BrushTextSecondary}"
                                Text="{DynamicResource LogoSizeAndLocationTip}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            Margin="0,12,0,0"
                            ColumnDefinitions="*,12,*"
                            RowDefinitions="Auto,12,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextPrimary}"
                                    Text="{DynamicResource LogoWidth}" />
                                <TextBox
                                    Name="NameLogoWidth"
                                    Height="34"
                                    Margin="0,6,0,0"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding LogoWidth, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextPrimary}"
                                    Text="{DynamicResource LogoHeight}" />
                                <TextBox
                                    Name="NameLogoHeight"
                                    Height="34"
                                    Margin="0,6,0,0"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding LogoHeight, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextPrimary}"
                                    Text="{DynamicResource LogoX}" />
                                <TextBox
                                    Name="NameLogoX"
                                    Height="34"
                                    Margin="0,6,0,0"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding LogoX, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock
                                    Foreground="{DynamicResource BrushTextPrimary}"
                                    Text="{DynamicResource LogoY}" />
                                <TextBox
                                    Name="NameLogoY"
                                    Height="34"
                                    Margin="0,6,0,0"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding LogoY, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock
                                Foreground="{DynamicResource BrushTextPrimary}"
                                Text="边框色：" />
                            <ComboBox
                                Name="NameBorderColor"
                                Height="34"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding AvailableColors}"
                                SelectedItem="{Binding SelectedColor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="100"
                                            Height="20"
                                            Background="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button
                            Name="NameDelogoButton"
                            Height="36"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DelogoCommand}"
                            Content="{DynamicResource Delogo}"
                            Theme="{StaticResource BtnStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,24,0,0">
                <TextBlock
                    Foreground="{DynamicResource BrushTextPrimary}"
                    Text="{DynamicResource OutputInfo}" />
                <TextBox
                    Name="NameStatus"
                    Height="140"
                    Margin="0,8,0,0"
                    Background="{DynamicResource BrushSurfaceSunken}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    Foreground="{DynamicResource BrushTextPrimary}"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding Status, Mode=TwoWay}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="TextChanged">
                            <InvokeCommandAction
                                Command="{Binding StatusCommand}"
                                CommandParameter="{Binding #NameStatus}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                </TextBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
