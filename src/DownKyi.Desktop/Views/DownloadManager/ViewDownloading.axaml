<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DownKyi.Views.DownloadManager.ViewDownloading"
             xmlns:images="clr-namespace:DownKyi.Images"
             xmlns:vmdm="clr-namespace:DownKyi.ViewModels.DownloadManager"
             x:DataType="vmdm:ViewDownloadingViewModel">
    <UserControl.Resources>
        <ControlTheme x:Key="DownloadingStyle" TargetType="{x:Type ListBoxItem}" x:DataType="vmdm:DownloadingItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            Name="NameTaskRow"
                            Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}, Path=Bounds.Width}"
                            Height="86"
                            Padding="14,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource DownKyiRadiusSmall}">
                            <Grid ColumnDefinitions="52,1.05*,1.75*,92">

                                <Border
                                    Name="NameZoneIconFrame"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BrushPrimaryTranslucent3}"
                                    CornerRadius="{DynamicResource DownKyiRadiusSmall}">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="{Binding ZoneImage}" />
                                </Border>

                                <!--  标题等视频信息  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Spacing="6">

                                    <TextBlock
                                        Name="NameTaskTitle"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource BrushTextPrimary}"
                                        TextTrimming="CharacterEllipsis">
                                        <ToolTip.Tip>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}-{1}">
                                                        <Binding Path="MainTitle" />
                                                        <Binding Path="Name" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </ToolTip.Tip>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}-{1}-{2}">
                                                <Binding Path="Order" />
                                                <Binding Path="MainTitle" />
                                                <Binding Path="Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock
                                        Name="NameTaskMetadata"
                                        FontSize="12"
                                        Foreground="{DynamicResource BrushTextSecondary}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2} · {3}">
                                                <Binding Path="Duration" />
                                                <Binding Path="Resolution.Name" />
                                                <Binding Path="VideoCodecName" />
                                                <Binding Path="AudioCodec.Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!--  进度条  -->
                                <Grid
                                    Grid.Column="2"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    RowDefinitions="Auto,6,Auto"
                                    RowSpacing="6">

                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Name="NameTaskContent"
                                                FontSize="12"
                                                Foreground="{DynamicResource BrushTextPrimary}"
                                                Text="{Binding DownloadContent}" />
                                            <TextBlock
                                                Name="NameTaskStatus"
                                                FontSize="12"
                                                Foreground="{DynamicResource BrushTextPrimary}"
                                                Text="{Binding StringFormat={} · {0}, Path=DownloadStatusTitle}">
                                                <Interaction.Behaviors>
                                                    <DataTriggerBehavior Binding="{Binding DownloadContent}"
                                                                         Value="">
                                                        <ChangePropertyAction PropertyName="Text"
                                                                              Value="{Binding DownloadStatusTitle}" />
                                                    </DataTriggerBehavior>
                                                </Interaction.Behaviors>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock
                                            Name="NameTaskProgressPercentage"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding Progress, StringFormat={}{0:0}%}" />
                                    </Grid>

                                    <ProgressBar
                                        Name="NameTaskProgress"
                                        Grid.Row="1"
                                        Height="6"
                                        BorderBrush="{x:Null}"
                                        BorderThickness="0"
                                        Value="{Binding Progress}">
                                        <ProgressBar.Theme>
                                            <ControlTheme TargetType="{x:Type ProgressBar}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <Border
                                                                Name="PART_Track"
                                                                Background="{DynamicResource BrushControlFill}"
                                                                BorderThickness="0"
                                                                ClipToBounds="True"
                                                                CornerRadius="3">
                                                                <Border
                                                                    Name="PART_Indicator"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource BrushPrimary}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="3" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </ControlTheme>
                                        </ProgressBar.Theme>
                                    </ProgressBar>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Name="NameTaskSize"
                                            FontSize="12"
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding DownloadingFileSize}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Name="NameTaskSpeed"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource BrushTextSecondary}"
                                            Text="{Binding SpeedDisplay}" />
                                    </Grid>
                                </Grid>

                                <!--  控制面板，暂停继续删除  -->
                                <StackPanel
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <Button
                                        Name="NameTaskToggleButton"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        Padding="0"
                                        Command="{Binding ElementName=DownloadingList,Path=((vmdm:ViewDownloadingViewModel)DataContext).ToggleDownloadingCommand}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource BtnStyle}"
                                        ToolTip.Tip="{Binding OperationTip}">
                                        <ContentControl Width="18" Height="18">
                                            <Path
                                                Width="{Binding StartOrPause.Width}"
                                                Height="{Binding StartOrPause.Height}"
                                                Data="{Binding StartOrPause.Data}"
                                                Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </ContentControl>
                                    </Button>

                                    <Button
                                        Name="NameTaskDeleteButton"
                                        Width="36"
                                        Height="36"
                                        MinWidth="36"
                                        MinHeight="36"
                                        Padding="0"
                                        Command="{Binding ElementName=DownloadingList,Path=((vmdm:ViewDownloadingViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Foreground="{DynamicResource BrushWarning}"
                                        Theme="{StaticResource BtnStyle}"
                                        ToolTip.Tip="{DynamicResource DeleteDownload}">
                                        <ContentControl Width="18" Height="18">
                                            <Path
                                                Width="18"
                                                Height="18"
                                                Data="{Binding Data, Source={x:Static images:ButtonIcon.Trash}}"
                                                Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                                Stretch="Uniform" />
                                        </ContentControl>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid>
        <Grid
            Name="NameDownloadingContent"
            Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=Bounds.Height}"
            RowDefinitions="*,1,58"
            IsVisible="{Binding DownloadingList.Count}">
            <ListBox
                Name="DownloadingList"
                Grid.Row="0"
                BorderThickness="0"
                ItemContainerTheme="{StaticResource DownloadingStyle}"
                ItemsSource="{Binding DownloadingList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Theme>
                    <ControlTheme TargetType="ListBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBox">
                                    <Border
                                        x:Name="Bd"
                                        Padding="0"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            Width="{TemplateBinding Width}"
                                                            Height="{TemplateBinding Height}" />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </ControlTheme>
                </ListBox.Theme>
            </ListBox>

            <TextBlock Grid.Row="1" Background="{DynamicResource BrushBorderTranslucent}" />

            <Border
                Name="NameBatchActionBar"
                Grid.Row="2"
                Padding="16,0"
                Background="{DynamicResource BrushSurfaceRaised}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel
                        Name="NameBatchSummary"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource BrushTextPrimary}"
                            Text="{DynamicResource TotalDownloading1}" />
                        <TextBlock
                            Name="NameDownloadingCount"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource BrushTextPrimary}"
                            Text="{Binding DownloadingList.Count}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource BrushTextPrimary}"
                            Text="{DynamicResource TotalDownloading2}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <StackPanel
                            Name="NameSafeBatchActions"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                Name="NamePauseAllButton"
                                MinWidth="104"
                                Command="{Binding PauseAllDownloadingCommand}"
                                FontSize="12"
                                Theme="{StaticResource BtnStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Data, Source={x:Static images:ButtonIcon.Pause}}"
                                        Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource PauseAllDownloading}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Name="NameContinueAllButton"
                                MinWidth="104"
                                Command="{Binding ContinueAllDownloadingCommand}"
                                FontSize="12"
                                Theme="{StaticResource BtnStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Data, Source={x:Static images:ButtonIcon.Start}}"
                                        Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource ContinueAllDownloading}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border
                            Name="NameDeleteBatchDivider"
                            Width="1"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrushBorderSubtle}" />

                        <Button
                            Name="NameDeleteAllButton"
                            MinWidth="104"
                            Background="{DynamicResource BrushControlFill}"
                            Command="{Binding DeleteAllDownloadingCommand}"
                            FontSize="12"
                            Foreground="{DynamicResource BrushWarning}"
                            Theme="{StaticResource BtnStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{Binding Data, Source={x:Static images:ButtonIcon.Trash}}"
                                    Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}, Path=Foreground}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource DeleteAllDownloading}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!--  TODO 没有数据时显示图片或文字  -->
        <Image
            Width="256"
            Height="256"
            Source="/Resources/nodata02.png"
            IsVisible="{Binding !DownloadingList.Count}" />
    </Grid>
</UserControl>
