<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorWindowBorder">Black</Color>
    <Color x:Key="ColorCaptionForeground">white</Color>
    <Color x:Key="ColorCaptionBackground">#7FD0D0D0</Color>
    <Color x:Key="ColorSystemBtnTint">white</Color>
    <Color x:Key="ColorSystemBtnTintDark">black</Color>
    <Color x:Key="ColorSystemBtnHover">#FF6ECEF8</Color>
    <Color x:Key="ColorSystemBtnPressed">#FF30B8F6</Color>
    <Color x:Key="ColorCloseBtnHover">#FFF1707A</Color>
    <Color x:Key="ColorCloseBtnPressed">#FFE81123</Color>

    <Color x:Key="ColorWarning">#FFFF4D3C</Color>

    <Color x:Key="ColorPrimary">#FF3EA6FF</Color>
    <Color x:Key="ColorPrimaryTranslucent">#C83EA6FF</Color>
    <Color x:Key="ColorPrimaryTranslucent2">#7F3EA6FF</Color>
    <Color x:Key="ColorPrimaryTranslucent3">#333EA6FF</Color>

    <Color x:Key="ColorSecond">#FFFB7299</Color>

    <Color x:Key="ColorSurfaceBase">#FF0F0F0F</Color>
    <Color x:Key="ColorSurfaceRaised">#FF212121</Color>
    <Color x:Key="ColorSurfaceSunken">#FF121212</Color>
    <Color x:Key="ColorSurfaceOverlay">#FF282828</Color>
    <Color x:Key="ColorMediaCanvas">#FF181818</Color>
    <Color x:Key="ColorTextPrimary">#FFF1F1F1</Color>
    <Color x:Key="ColorTextSecondary">#FFAAAAAA</Color>
    <Color x:Key="ColorBorderSubtle">#FF303030</Color>
    <Color x:Key="ColorControlFill">#1AFFFFFF</Color>
    <Color x:Key="ColorControlFillHover">#24FFFFFF</Color>
    <Color x:Key="ColorControlFillPressed">#33FFFFFF</Color>
    <Color x:Key="ColorControlStroke">#33FFFFFF</Color>
    <Color x:Key="ColorControlStrokeFocus">#FF1C62B9</Color>
    <Color x:Key="ColorSelectionFill">#33FFFFFF</Color>
    <Color x:Key="ColorToggleTrack">#FF717171</Color>
    <Color x:Key="ColorToggleThumbOff">#FFAAAAAA</Color>

    <Color x:Key="ColorForeground">#FF00A1D6</Color>
    <Color x:Key="ColorBackground">#FF0F0F0F</Color>
    <Color x:Key="ColorForegroundDark">#FFFFFFFF</Color>
    <Color x:Key="ColorBackgroundDark">#FF00A1D6</Color>
    <Color x:Key="ColorForegroundGrey">#FFBDBDBD</Color>
    <Color x:Key="ColorForegroundGrey2">#FFE4E4E4</Color>
    <Color x:Key="ColorBackgroundGrey">#FFBDBDBD</Color>
    <Color x:Key="ColorBackgroundGreyTranslucent">#C8BDBDBD</Color>
    <Color x:Key="ColorBackgroundGreyTranslucent2">#7FBDBDBD</Color>
    <Color x:Key="ColorBackgroundGreyTranslucent3">#33BDBDBD</Color>

    <Color x:Key="ColorMask">#7F000000</Color>
    <Color x:Key="ColorMask100">#33999999</Color>

    <Color x:Key="ColorImageBorder">#7FD0D0D0</Color>
    <Color x:Key="ColorImageBorder2">#7FFFFFFF</Color>
    <Color x:Key="ColorImageBackground">#7FD0D0D0</Color>

    <Color x:Key="ColorProgressTrack">#FFE4E4E4</Color>
    <Color x:Key="ColorProgressIndicator">#FFF3CB85</Color>

    <Color x:Key="ColorText">Black</Color>
    <Color x:Key="ColorTextDark">#FFC7C7C7</Color>
    <Color x:Key="ColorTextGrey">#FF999999</Color>
    <Color x:Key="ColorTextGrey2">#FF8A8A8A</Color>

    <Color x:Key="ColorMoney">#FFFFAE00</Color>
    <Color x:Key="ColorPublication">#FF02B5DA</Color>

    <Color x:Key="ColorTabHeaderGrey">#FF141414</Color>
    <Color x:Key="ColorHeaderGrey">#FFF4F4F4</Color>

    <Color x:Key="ColorBorder">#FF999999</Color>
    <Color x:Key="ColorBorderTranslucent">#7F999999</Color>
    <Color x:Key="ColorBorderTranslucent100">#99000000</Color>

    <Color x:Key="ColorDataGridHighlight">#096085</Color>

</ResourceDictionary>
