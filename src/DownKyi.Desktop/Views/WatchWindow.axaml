<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DownKyi.ViewModels"
        x:Class="DownKyi.Views.WatchWindow"
        x:DataType="vm:WatchWindowViewModel"
        Title="BiliCinema · 仅观影"
        Width="1100" Height="900" MinWidth="800" MinHeight="650"
        Background="{DynamicResource BrushSurfaceBase}">
    <Grid x:Name="WatchLayout" Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border x:Name="PlayerSurface" Grid.Row="0" Background="Black" CornerRadius="{DynamicResource DownKyiRadiusMedium}">
            <NativeWebView x:Name="MovieWebView" Height="450" />
        </Border>
        <Grid x:Name="PlaybackToolbar" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="PlaybackStatus" Grid.Column="0" Text="{Binding Status}" FontSize="14"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushPrimary}" />
            <Button x:Name="FullscreenButton" Grid.Column="1" Content="全屏播放" Click="OnFullscreenClick"
                    ToolTip.Tip="全屏观看；按 Esc 退出" />
        </Grid>
        <ScrollViewer x:Name="WatchDetails" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <TextBlock Text="仅观影模式" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock Text="B 站网页播放器在本机取流；房间只同步选片和控制状态。"
                       Foreground="{DynamicResource BrushTextSecondary}" />

            <Border Padding="16" Background="{DynamicResource BrushSurfaceRaised}"
                    CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                <StackPanel Spacing="10">
                    <TextBlock Text="1  登录" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountStatus}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="获取扫码二维码" Command="{Binding LoginCommand}" />
                        <Button Content="退出本机账号" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                    <Image Source="{Binding LoginQrCode}" Width="170" Height="170"
                           HorizontalAlignment="Left" IsVisible="{Binding HasLoginQrCode}" />
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{DynamicResource BrushSurfaceRaised}"
                    CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                <StackPanel Spacing="10">
                    <TextBlock Text="2  影片" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" PlaceholderText="粘贴 B 站影片链接"
                                 Text="{Binding VideoInput, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="解析" Command="{Binding ParseCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding FilmTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="画质和音轨请在播放器画面内选择；可用画质由 B 站账号、影片和设备决定。" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MediaInfo}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{DynamicResource BrushSurfaceRaised}"
                    CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                <StackPanel Spacing="10">
                    <TextBlock Text="3  播放控制" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="在线播放 / 继续" Command="{Binding PlayCommand}" />
                        <Button Content="暂停" Command="{Binding PauseCommand}" />
                        <Button Content="停止并清理" Command="{Binding StopCommand}" />
                        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding SeekPositionSeconds, Mode=TwoWay}"
                            ToolTip.Tip="拖动后松开即可跳转；房间内由房主操作" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="跳转秒数" VerticalAlignment="Center" />
                        <TextBox Width="95" Text="{Binding SeekSeconds, Mode=TwoWay}" />
                        <Button Content="跳转" Command="{Binding SeekCommand}" />
                        <TextBlock Text="倍速" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBox Width="70" Text="{Binding RateText, Mode=TwoWay}" />
                        <Button Content="设置倍速" Command="{Binding RateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{DynamicResource BrushSurfaceRaised}"
                    CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                <StackPanel Spacing="10">
                    <TextBlock Text="4  私人同步房间" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="房主控制选片、播放、暂停、跳转与倍速；每台电脑都用自己的登录状态取流。"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="服务地址" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ServiceAddress, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="创建房间" Command="{Binding CreateRoomCommand}" />
                        <Button Content="复制邀请" Command="{Binding CopyInviteCommand}" />
                        <Button Content="离开房间" Command="{Binding LeaveRoomCommand}" />
                        <Button Content="结束房间" Command="{Binding EndRoomCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" PlaceholderText="粘贴邀请地址或邀请码"
                                 Text="{Binding InviteText, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="加入房间" Command="{Binding JoinRoomCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding RoomState}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
