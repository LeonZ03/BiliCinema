<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DownKyi.ViewModels"
        x:Class="DownKyi.Views.WatchWindow"
        x:DataType="vm:WatchWindowViewModel"
        Title="BiliCinema" Width="1180" Height="860" MinWidth="860" MinHeight="620"
        Background="{DynamicResource BrushSurfaceBase}" Icon="/Resources/favicon.ico">
    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="Auto,*">
        <Border x:Name="Sidebar" Grid.Column="0" Width="200" Padding="16,24"
                Background="{DynamicResource BrushSurfaceRaised}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,26">
                        <Image Width="32" Height="32" Source="/Resources/bilicinema-mark.png" />
                        <TextBlock Text="BiliCinema" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BrushPrimary}" />
                    </StackPanel>
                    <ProgressBar IsVisible="{Binding IsPreparing}" IsIndeterminate="True" Height="4" />
                    <Button Classes="nav" Classes.selected="{Binding ShowLogin}" Content="登录" Command="{Binding ShowLoginCommand}" />
                    <Button Classes="nav" Classes.selected="{Binding ShowRoom}" Content="观影房间" Command="{Binding ShowRoomCommand}" />
                    <Button Classes="nav" Classes.selected="{Binding ShowDownload}" Content="下载影片" Command="{Binding ShowDownloadCommand}" />
                </StackPanel>
                <TextBlock Text="与好友一起看 B 站" VerticalAlignment="Bottom" Margin="7,0,0,0"
                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" />
            </DockPanel>
        </Border>

        <Grid x:Name="WatchLayout" Grid.Column="1" Margin="22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <Border x:Name="RoomPlayerSurface" Grid.Row="0" Height="440" Background="Black"
                    IsVisible="{Binding ShowRoom}"
                    ClipToBounds="True" CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                <NativeWebView x:Name="RoomMovieWebView" Height="440"
                               Opacity="{Binding PlayerOpacity}"
                               IsHitTestVisible="{Binding PlayerReady}" />
            </Border>
            <Grid x:Name="PlaybackToolbar" Grid.Row="1"
                  IsVisible="{Binding ShowPlayer}">
                <TextBlock x:Name="PlaybackStatus" Text="{Binding Status}" FontSize="14"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushPrimary}" />
            </Grid>

            <ScrollViewer x:Name="WatchDetails" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ShowPlayer}">
                <StackPanel Spacing="14">
                    <Border IsVisible="{Binding ShowRoom}" Padding="20"
                            Background="{DynamicResource BrushSurfaceRaised}"
                            CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Text="观影房间" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding RoomParticipantText}" FontSize="14"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushPrimary}" />
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="解析视频后将在上方播放。" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="房间内观影进度由房主统一控制。" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="鼠标移至视频右侧呼出聊天框，Alt 收起。" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <Border IsVisible="{Binding IsInRoom}" Padding="9,4" HorizontalAlignment="Left"
                                            Background="{DynamicResource BrushSurfaceSunken}" CornerRadius="8">
                                        <TextBlock Text="{Binding RoomRoleText}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushPrimary}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Text="我的昵称" FontSize="14" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" MaxLength="24" PlaceholderText="聊天时显示的昵称"
                                                 Text="{Binding RoomNicknameInput, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Content="保存" Command="{Binding SaveRoomNicknameCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding RoomNicknameStatus}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                <TextBox Grid.Column="0" PlaceholderText="粘贴 B 站视频链接"
                                         Text="{Binding RoomVideoInput, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="解析视频" Command="{Binding ParseCommand}"
                                        IsEnabled="{Binding CanControl}" />
                            </Grid>
                            <TextBlock Text="{Binding RoomFilmTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="服务地址" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Padding="12,9" MinHeight="40"
                                        Background="{DynamicResource BrushSurfaceBase}"
                                        CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                                    <TextBlock Text="{Binding ServiceAddressDisplay}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="创建房间" Command="{Binding CreateRoomCommand}" />
                                <Button Content="复制邀请" Command="{Binding CopyInviteCommand}" />
                                <Button Content="离开房间" Command="{Binding LeaveRoomCommand}" />
                                <Button Content="结束房间" Command="{Binding EndRoomCommand}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" PlaceholderText="加入其他房间时，在这里粘贴邀请地址"
                                         Text="{Binding InviteText, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="加入房间" Command="{Binding JoinRoomCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding RoomState}" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Name="SyncPlaybackButton" Grid.Column="1" Width="36" Height="36" Padding="8"
                                        Command="{Binding SyncPlaybackCommand}"
                                        AutomationProperties.Name="同步并检查播放器" ToolTip.Tip="检查播放器状态；房间内同时同步播放进度"
                                        Background="{DynamicResource BrushSurfaceSunken}"
                                        CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                              Data="M 17,2 L 17,7 L 12,7 M 17,7 A 7,7 0 0 0 4,5 M 3,18 L 3,13 L 8,13 M 3,13 A 7,7 0 0 0 16,15"
                                              Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.7"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowLogin}">
                <Border Padding="24" Background="{DynamicResource BrushSurfaceRaised}"
                        CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="登录" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AccountStatus}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushPrimary}" />
                        <TextBlock Text="扫码后即可在线播放及下载支持的影片。" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Button Content="获取登录二维码" Command="{Binding LoginCommand}" />
                            <Button Content="退出本机账号" Command="{Binding LogoutCommand}" />
                        </StackPanel>
                        <Image Source="{Binding LoginQrCode}" Width="190" Height="190"
                               HorizontalAlignment="Left" IsVisible="{Binding HasLoginQrCode}" />
                        <Button Content="复制二维码图片" Command="{Binding CopyLoginQrCommand}"
                                HorizontalAlignment="Left" IsVisible="{Binding HasLoginQrCode}" />
                        <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ShowDownload}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="下载影片" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="下载功能源自开源项目" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <Image Source="/Resources/downkyi-mark.png" Width="16" Height="16"
                                   VerticalAlignment="Center" AutomationProperties.Name="DownKyi 标志" />
                            <TextBlock Text="DownKyi Core。" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                    <ContentControl Grid.Row="1" Content="{Binding DownloadContent.MainContent}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
